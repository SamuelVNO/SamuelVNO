# Opcional: preencha para sincronizar os dados entre voce e sua esposa
# (celular + computador). Sem estas variaveis o app funciona 100% offline,
# salvando no proprio aparelho.
#
# Os valores saem do painel do Firebase, em Configuracoes do projeto >
# Seus aplicativos > Aplicativo da Web > Configuracao do SDK.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcionais, so preencha se o painel mostrar:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
